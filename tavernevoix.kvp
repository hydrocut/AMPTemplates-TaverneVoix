Meta.DisplayName=Voix de la Taverne - serveur vocal LiveKit (TeamKit)
Meta.Description=Serveur vocal de La Taverne de TeamKit : LiveKit 1.13.9 (open source, Apache 2.0), le programme officiel telecharge sur GitHub et verifie par son empreinte SHA-256. Une piece vocale par table, voix relayee en direct, JAMAIS enregistree (ni egress ni ingress, pas de TURN). Signalisation sur 7880 derriere nginx en HTTPS (wss://voix.teamkit.fr, port ferme au monde), voix sur un seul port UDP 7882 et secours TCP 7881. Cle d'API et secret en champs mot de passe. Conteneur obligatoire.
Meta.OS=Linux
Meta.Arch=x86_64
Meta.AarchSupport=NotSupported
Meta.Author=TeamKit
Meta.URL=https://github.com/hydrocut/AMPTemplates-TaverneVoix
Meta.DisplayImageSource=url:https://www.teamkit.fr/assets/brand/apple_touch_icon_512.png
Meta.EndpointURIFormat=https://voix.teamkit.fr
Meta.ConfigManifest=tavernevoixconfig.json
Meta.MetaConfigManifest=tavernevoixmetaconfig.json
Meta.ConfigRoot=tavernevoix.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=True
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Required
Meta.ContainerPolicyReason=LiveKit (binaire officiel, empreinte verifiee) est installe dans le dossier de l'instance par un script ; le conteneur ponte isole le serveur vocal du reste de la machine (pas de reseau hote).
Meta.ExtraSetupStepsURI=https://github.com/hydrocut/AMPTemplates-TaverneVoix#install-in-amp
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppConfigId=8553dda4-55b6-49ee-b521-aa36abaf2404
Meta.ImportableExtensions=[]
